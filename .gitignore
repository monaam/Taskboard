# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
# Leading slash: the frontend build only. Netlify builds it, so it stays out.
# server/dist IS committed on purpose -- the Forge box cannot run tsc (earlyoom
# kills it, see the deploy script), so the compiled backend ships in git.
# Rebuild it with `npm run build` in server/ before committing backend changes.
/dist
dist-ssr
*.local

# Secrets. No leading slash, so these match at any depth — server/.env included.
.env
.env.*
# A committed template is the point of having one; it must hold no real values.
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.claude/
