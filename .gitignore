# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
# Both builds are committed on purpose -- the Forge box cannot run tsc or vite
# build (earlyoom SIGTERMs the largest node process below ~390MB available, see
# the deploy script), so compiled output ships in git instead.
#
# server/dist: pulled by the deploy script, which then restarts the daemon.
# /dist: nginx serves it as the site root, and the deploy script only builds the
# backend -- so `git pull` is the ONLY thing that updates the frontend in
# production. It used to be ignored here, which left a two-month-old bundle
# serving against a migrated API: the frontend sent `completed` while the API
# had moved to `status`, so ticking an item silently did nothing.
#
# Before pushing: `npm run build` (frontend, reads .env.production) and
# `npm run build` in server/ (backend). The pre-commit hook does the latter.
dist-ssr
*.local

# Secrets. No leading slash, so these match at any depth — server/.env included.
.env
.env.*
# A committed template is the point of having one; it must hold no real values.
!.env.example
# Not a secret: the production API URL, which Vite bakes into the bundle at
# build time. Without it `npm run build` silently emits a dist pointing at
# localhost:3001.
!.env.production

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.claude/
