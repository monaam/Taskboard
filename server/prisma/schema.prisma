generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  checklists Checklist[]
  textNotes  TextNote[]
  apiTokens  ApiToken[]
  sharedWithMe ChecklistShare[]
  placements   ChecklistPlacement[]
}

model Checklist {
  id        String   @id @default(uuid())
  title     String
  x         Float
  y         Float
  color     String   @default("default")
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items      ChecklistItem[]
  shares     ChecklistShare[]
  placements ChecklistPlacement[]

  @@index([userId])
}

model ChecklistItem {
  id        String   @id @default(uuid())
  text      String   @db.Text
  status    String   @default("todo")

  scheduledFor String?
  dueDate      String?
  impact       String?
  effort       String?
  notes        String? @db.Text

  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  checklistId String
  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@index([checklistId])
}

model TextNote {
  id        String   @id @default(uuid())
  text      String   @db.Text
  x         Float
  y         Float
  fontSize  Float    @default(24)
  color     String   @default("default")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A personal access token, for agents and scripts calling the API directly.
model ApiToken {
  id String @id @default(uuid())

  /// What it is for, chosen by the user. Not unique: two agents may share a name.
  name String

  /// SHA-256 hex of the full token. The plaintext is shown once at creation and
  /// never stored, so a database leak cannot be replayed against the API.
  ///
  /// SHA-256 rather than bcrypt deliberately: this runs on every authenticated
  /// request, and the token is 32 random bytes, so there is no low-entropy
  /// secret for a slow hash to protect. Unique, so verification is one indexed
  /// lookup rather than a scan.
  tokenHash String @unique

  /// The first few characters, for telling tokens apart in the UI. Not a secret
  /// and far too short to brute-force the rest from.
  prefix String

  /// 'read' | 'write'. Enforced by HTTP method in the auth middleware, so a new
  /// route cannot forget to check it.
  scope String

  /// null means it never expires.
  expiresAt DateTime?

  /// Written at most once a minute, not on every request -- see the auth
  /// middleware. Lets a forgotten token be spotted.
  lastUsedAt DateTime?

  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Grants another account edit access to a checklist.
///
/// Membership is a single level on purpose: a member can do everything to the
/// contents that the owner can. What stays with the owner is the list itself --
/// deleting it, renaming it, recolouring it, and deciding who is in it.
model ChecklistShare {
  id String @id @default(uuid())

  checklistId String
  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  /// The member. Cascades, so deleting an account withdraws its memberships.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  /// One membership per person per list. Re-sharing is an upsert, not a
  /// duplicate row that would make "is this person a member" ambiguous.
  @@unique([checklistId, userId])
  @@index([userId])
}

/// Where a member has put a shared list on their own board.
///
/// The owner's placement stays on Checklist.x/y/order, which is why this table
/// holds no rows for owners: moving the columns would have meant migrating
/// every existing list and changing what the API returns. The rule is one line
/// -- the owner's placement is on the row, everyone else's is here -- and
/// resolvePlacement is the only code that needs to know it.
///
/// Without this, one member dragging a card would move it on every other
/// member's canvas.
model ChecklistPlacement {
  id String @id @default(uuid())

  checklistId String
  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  x     Float
  y     Float
  order Int    @default(0)

  @@unique([checklistId, userId])
  @@index([userId])
}
